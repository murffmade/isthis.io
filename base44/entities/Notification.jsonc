{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user receiving the notification"
    },
    "type": {
      "type": "string",
      "enum": [
        "click",
        "conversion",
        "payout_pending",
        "payout_processed",
        "system_update",
        "feature_announcement"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "data": {
      "type": "object",
      "description": "Additional data (amount, link, etc.)"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification has been read"
    },
    "action_url": {
      "type": "string",
      "description": "Optional URL to navigate to"
    }
  },
  "required": [
    "user_email",
    "type",
    "title",
    "message"
  ]
}