{
  "name": "AffiliateClick",
  "type": "object",
  "properties": {
    "affiliate_code": {
      "type": "string",
      "description": "Affiliate code that was clicked"
    },
    "user_email": {
      "type": "string",
      "description": "User who clicked (if logged in)"
    },
    "converted": {
      "type": "boolean",
      "default": false,
      "description": "Whether click resulted in purchase"
    },
    "conversion_value": {
      "type": "number",
      "description": "Value of conversion in dollars"
    },
    "conversion_date": {
      "type": "string",
      "format": "date-time",
      "description": "When conversion occurred"
    }
  },
  "required": [
    "affiliate_code"
  ]
}