{
  "name": "BatchJob",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of user who created batch"
    },
    "org_id": {
      "type": "string",
      "description": "Organization ID if applicable"
    },
    "name": {
      "type": "string",
      "description": "User-defined name for batch"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Processing status"
    },
    "total_items": {
      "type": "number",
      "description": "Total number of items in batch"
    },
    "completed_items": {
      "type": "number",
      "default": 0,
      "description": "Number of completed assessments"
    },
    "summary": {
      "type": "object",
      "properties": {
        "low_risk_count": {
          "type": "number"
        },
        "medium_risk_count": {
          "type": "number"
        },
        "high_risk_count": {
          "type": "number"
        },
        "avg_likelihood": {
          "type": "number"
        },
        "top_signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outliers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Aggregate batch statistics"
    }
  },
  "required": [
    "name",
    "total_items"
  ]
}