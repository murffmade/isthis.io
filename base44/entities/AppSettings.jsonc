{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "feature_is_this_real": {
      "type": "boolean",
      "default": true,
      "description": "Enable Is This Real? feature"
    },
    "feature_is_this_true": {
      "type": "boolean",
      "default": true,
      "description": "Enable Is This True? feature"
    },
    "feature_is_this_scam": {
      "type": "boolean",
      "default": true,
      "description": "Enable Is This a Scam? feature"
    },
    "feature_is_this_safe": {
      "type": "boolean",
      "default": true,
      "description": "Enable Is This Safe? feature"
    },
    "lifetime_offer_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable lifetime offer on pricing page"
    },
    "lifetime_sold_count": {
      "type": "number",
      "default": 0,
      "description": "Number of lifetime licenses sold"
    },
    "lifetime_max_count": {
      "type": "number",
      "default": 500,
      "description": "Maximum number of lifetime licenses to sell"
    },
    "lifetime_expiry_date": {
      "type": "string",
      "format": "date",
      "default": "2026-01-03",
      "description": "Date when lifetime offer expires"
    },
    "lifetime_show_countdown": {
      "type": "boolean",
      "default": true,
      "description": "Show countdown timer for lifetime offer"
    }
  },
  "required": []
}